# ═══════════════════════════════════════════════════════════════
# Attendance App — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
# Required. Connection string for your PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no spaces).
# Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── App ───────────────────────────────────────────────────────
# The title shown in the FastAPI docs (Swagger UI).
# Default: Attendance API
# APP_TITLE=Attendance API

# ── Auth ──────────────────────────────────────────────────────
# PIN required to access the app.
# Default: 7283
# APP_PIN=7283

# ── Runtime ───────────────────────────────────────────────────
# Enable debug mode (shows detailed error traces).
# Default: false
# DEBUG=false

# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default: INFO
# LOG_LEVEL=INFO
